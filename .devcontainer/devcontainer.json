{
  "name": "Bazaario (Django)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "containerEnv": {
    "TRUST_PROXY": "1",
    "ADMIN_EMAIL": "admin@bazaario.local",
    "ADMIN_PASSWORD": "ChangeMe123"
  },
  "postCreateCommand": "pip install -r requirements.txt && python manage.py migrate && python manage.py seed",
  "postAttachCommand": "python manage.py runserver 0.0.0.0:8000",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Bazaario store", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-python.debugpy", "batisteo.vscode-django"] }
  }
}
