{
  "name": "bazaario",
  "version": "1.0.0",
  "description": "Bazaario - a full-featured online marketplace (catalog, search, cart, wishlist, checkout, orders, reviews, admin) with production-grade security controls.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "seed": "node --no-warnings src/seed.js --reset",
    "test": "node --no-warnings --test tests/*.test.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0"
  }
}
