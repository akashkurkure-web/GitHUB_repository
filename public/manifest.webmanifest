{
  "id": "/",
  "name": "Bazaario - Your Online Bazaar",
  "short_name": "Bazaario",
  "description": "Mobiles, electronics, fashion, home, books and more with free delivery, easy returns and Cash on Delivery.",
  "lang": "en-IN",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F6F5F2",
  "theme_color": "#0F5E5B",
  "categories": ["shopping"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today's deals", "url": "/#/s?deals=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Your orders", "url": "/#/orders", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Your bag", "url": "/#/cart", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
