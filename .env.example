# Copy to .env (never commit it) and load before starting, e.g.  set -a; . ./.env; set +a
DJANGO_PRODUCTION=1
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=yourstore.in,www.yourstore.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourstore.in,https://www.yourstore.in
# Behind Nginx / a load balancer that terminates TLS
TRUST_PROXY=1
STORE_NAME=Bazaario
# First admin account (created by `python manage.py seed` if missing)
ADMIN_EMAIL=admin@yourstore.in
ADMIN_PASSWORD=change-me-Str0ngPassw0rd
# Optional: database file location (default ./data/bazaario.sqlite3)
# DB_FILE=/var/lib/bazaario/bazaario.sqlite3
