# Copy to .env (never commit .env) and export before starting, e.g.  set -a; . ./.env; set +a
NODE_ENV=production
PORT=3000
STORE_NAME=Bazaario
# First admin account (created on first start only). Use a strong unique password.
ADMIN_EMAIL=admin@yourdomain.in
ADMIN_PASSWORD=change-me-Str0ngPassw0rd
# Optional: database location (default ./data/bazaario.db)
# DB_FILE=/var/lib/bazaario/bazaario.db
# Company and Grievance Officer details shown on policy pages (Consumer Protection (E-Commerce) Rules 2020)
COMPANY_NAME=Your Company Private Limited, GSTIN 27XXXXX0000X1Z5
# Bazaario Direct's own GSTIN and state (printed on Direct invoices; decides CGST/SGST or IGST)
COMPANY_GSTIN=27XXXXX0000X1Z5
COMPANY_STATE=Maharashtra
GRIEVANCE_OFFICER_NAME=Full Name, Grievance Officer
GRIEVANCE_OFFICER_EMAIL=grievance@yourdomain.in
GRIEVANCE_OFFICER_PHONE=+91 00000 00000
GRIEVANCE_OFFICER_ADDRESS=Registered office address
# Partners. Leave unset to run in test mode (nothing is charged or sent).
# PAYMENT_PROVIDER=razorpay
# COURIER_PROVIDER=shiprocket
# SMS_PROVIDER=msg91
# Express riders: in test courier mode riders pick up and deliver on their own when their expected time comes.
# Set to 0 to move them by hand from Studio > Express instead.
# RIDER_SIMULATION=1
