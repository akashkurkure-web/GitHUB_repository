# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Server-only. Never prefix with NEXT_PUBLIC_. Used for uploads, payments and documents.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Your public website address ───────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Razorpay (Dashboard → Account & Settings → API keys) ──────────
# Leave blank to run with proforma / bank transfer only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Bank details printed on proforma invoices ─────────────────────
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_IFSC=

# ── WhatsApp Cloud API (optional; Meta Business → WhatsApp → API setup) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
