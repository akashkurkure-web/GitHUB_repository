# Copy to .env for local use. On Vercel, add these under Settings > Environment Variables.

# --- Required on Vercel -------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Set automatically when you connect a Neon / Vercel Postgres database:
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=choose-a-strong-password

# --- Brand and company (shown on the website, invoices and legal pages) -------
PORTAL_NAME=Akriti 3D
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=Mumbai, Maharashtra, India
COMPANY_GSTIN=
COMPANY_CIN=
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=

# --- Payments: leave empty until the company account opens (team shares details manually)
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IFSC=
BANK_NAME=
UPI_ID=

# --- Business rules -----------------------------------------------------------
COMMISSION_PERCENT=15
GST_PERCENT=18
ADVANCE_THRESHOLD=50000
ADVANCE_PERCENT=50

# --- Email (needed for password links and order emails) -----------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Akriti 3D <orders@yourdomain.in>

# --- Optional -----------------------------------------------------------------
# SITE_URL=https://www.yourdomain.in
# DJANGO_ALLOWED_HOSTS=www.yourdomain.in,yourdomain.in
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.yourdomain.in,https://yourdomain.in
# MAX_UPLOAD_MB=4
